# Copy this file to .env and change values for your environment.

DATABASE_URL=postgresql://postgres:test1234!@localhost:5432/football-bet
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173
DB_AUTO_CREATE_TABLES=true
